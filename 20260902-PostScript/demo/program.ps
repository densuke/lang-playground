%!PS
% Not just a page format: loops, branches and recursion.
1 1 5 { = } for                          % loop: print 1 to 5

/fact {                                  % recursion: n fact -> n!
    dup 1 le { pop 1 } { dup 1 sub fact mul } ifelse
} def
10 fact =

7 2 mod 0 eq { (even) } { (odd) } ifelse =   % branch
